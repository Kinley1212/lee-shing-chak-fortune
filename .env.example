GEMINI_API_KEY=your_gemini_api_key_here
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_EMBEDDING_DIMENSIONS=768
RAG_SEMANTIC_WEIGHT=0.65
RAG_MIN_SEMANTIC_SCORE=0.62
RAG_UNSCOPED_MIN_SEMANTIC_SCORE=0.68
